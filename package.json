{
  "name": "reboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "docs:check": "node scripts/docs-check.mjs",
    "progress": "node scripts/progress.mjs",
    "attribution:check": "node scripts/no-ai-attribution.mjs --history",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:live": "tsx --env-file=.env.neon scripts/db-migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/db-seed.ts",
    "db:seed:live": "tsx --env-file=.env.local --env-file=.env.neon scripts/db-seed.ts",
    "deploy:prod": "vercel deploy --prod",
    "live:check": "node scripts/live-smoke.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@gsap/react": "^2.1.2",
    "@noble/hashes": "2.4.0",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.16.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fast-check": "^4.10.2",
    "jsqr": "1.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.9"
}
